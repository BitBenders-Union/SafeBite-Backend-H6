{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Global": {
      "AdminPermitLimit": 200,
      "UserPermitLimit": 50
    },
    "Scan": {
      "PermitLimit": 10
    }
  },
  "Testing": {
    "UseFakeOcr": false,
    "UseFakeScanAnalysis": false
  }
}
