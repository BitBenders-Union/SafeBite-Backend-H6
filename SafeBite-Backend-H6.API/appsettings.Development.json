{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "RateLimiting": {
    "Global": {
      "AdminPermitLimit": 10000,
      "UserPermitLimit": 5000
    },
    "Scan": {
      "PermitLimit": 500
    }
  },

  "Testing": {
    "UseFakeOcr": true,
    "UseFakeScanAnalysis": true
  }
}
