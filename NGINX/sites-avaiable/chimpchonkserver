server {
    listen 443 ssl;
    server_name dev.chimpchonkserver.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/chimpchonkserver.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chimpchonkserver.duckdns.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 100M;

    # Dev API
    location / {
        proxy_pass https://127.0.0.1:9443/;  # container port on host
        proxy_ssl_verify off;  # disable cert check if it's self-signed
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100M;
        proxy_request_buffering off;
    }
}

